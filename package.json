{
  "name": "solar-site-precheck",
  "private": true,
  "version": "1.27.2",
  "type": "module",
  "scripts": {
    "dev": "vite build --configLoader runner && vite preview --configLoader runner --host 127.0.0.1 --port 5173",
    "develop": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 5173",
    "serve:dist": "node work/serve-dist.mjs",
    "share": "vite build --configLoader runner && vite preview --configLoader runner --host 0.0.0.0 --port 5173",
    "update:grid-capacity": "node work/update-chugoku-grid-capacity.mjs",
    "preflight:release": "node work/preflight-release.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify:csp": "node work/verify-csp-hosts.mjs",
    "verify:assets": "node build/verifyBrowserAssets.js",
    "package:deployment": "node build/packageDeployment.js",
    "verify:release": "node work/verify-release-metadata.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.0.227",
    "polygon-clipping": "0.15.7",
    "proj4": "^2.20.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.0"
  }
}
